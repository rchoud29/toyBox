<program>			::= <statement> [ <statement> ... ]
<statement>			::= ( <print_statement> | <assignment> ) ";"
<print_statement>	::= "print" "(" <expression> ")
<assignment>		::= <identifier> "=" <expression>
<expression>		::= <value> [ <operator> <expression> ]
<operator>			::= "+" | "-" | "*" | "/"
<value>				::= <number> | <identifier>
